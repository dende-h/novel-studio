        {
          "click": {
            "role": "button",
            "name": "作成",
            "exact": true
          }
        },
        {
          "waitFor": {
            "role": "heading",
            "name": "夜の校舎"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "「夜の校舎」を執筆"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "新しいエピソード",
            "exact": true
